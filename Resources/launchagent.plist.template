<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>            <string>com.mucahit26.notchlog</string>
    <key>ProgramArguments</key> <array><string>__BINARY__</string></array>
    <key>RunAtLoad</key>        <true/>
    <key>KeepAlive</key>        <true/>
    <!-- Guards against a crash loop hammering the CPU while KeepAlive restarts it. -->
    <key>ThrottleInterval</key> <integer>10</integer>
    <!-- It draws a panel, so it needs a GUI session. -->
    <key>LimitLoadToSessionType</key> <string>Aqua</string>
    <!-- Adaptive, NOT Background: Background assigns a low QoS and makes the process a
         candidate for CPU throttling, which would make the hover animation stutter. -->
    <key>ProcessType</key>      <string>Adaptive</string>
    <key>StandardOutPath</key>  <string>/dev/null</string>
    <key>StandardErrorPath</key><string>__LOGFILE__</string>
</dict>
</plist>
